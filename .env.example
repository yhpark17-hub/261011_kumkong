# 게시판·필기 후기 DB — 로컬은 파일, 배포는 Turso(libSQL) 주소와 토큰
DATABASE_URL=file:data/kumkong.db
# DATABASE_AUTH_TOKEN=

# 운영자 로그인 비밀번호와 세션 서명 키 (충분히 길고 무작위로)
ADMIN_PASSWORD=
ADMIN_SECRET=
# IP 를 그대로 저장하지 않고 해시할 때 쓰는 값
IP_SALT=

# 사진·파일 업로드 저장소 — Vercel 대시보드 > Storage > Blob 을 프로젝트에 연결하면 자동으로 들어갑니다.
# 로컬에서는 비워 두면 data/uploads 폴더에 저장됩니다.
# BLOB_READ_WRITE_TOKEN=

# 자동 점검(클라우드 루틴)이 /api/automation/* 를 부를 때 쓰는 토큰 (24자 이상 무작위)
# 루틴 환경 변수(또는 네트워크 시크릿)에도 같은 값을 넣습니다 — scripts/automation/ROUTINE.md
AUTOMATION_TOKEN=
# (선택) 승인한 일정 수정을 바로 저장소에 커밋할 GitHub fine-grained 토큰 (이 저장소 Contents 읽기·쓰기)
# 없으면 승인한 일정은 다음 자동 점검 때 반영됩니다.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/repo   (Vercel 에서는 자동으로 알아냄)

# 실제 서비스 도메인 (sitemap, OG 태그, canonical에 사용)
NEXT_PUBLIC_SITE_URL=https://kumkong.kr

# Google AdSense 퍼블리셔 ID (승인 후 입력). 비워 두면 광고가 표시되지 않습니다.
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000

# AdSense 콘솔 > 광고 > 광고 단위에서 만든 슬롯 ID
NEXT_PUBLIC_AD_SLOT_HOME_TOP=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_SIDEBAR_STICKY=
NEXT_PUBLIC_AD_SLOT_INFEED=
NEXT_PUBLIC_AD_SLOT_INARTICLE=
